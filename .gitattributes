# По умолчанию LF в репозитории и в рабочей копии (rustfmt пишет LF).
* text=auto eol=lf

# Windows-скрипты и проекты установщика — CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.iss  text eol=crlf
*.wxs  text eol=crlf
*.reg  text eol=crlf

# Бинарные файлы.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.webp binary
*.dll  binary
*.exe  binary
*.pdb  binary

# Большие артефакты (образы гостя, бенч-снапшоты) — через Git LFS, если когда-нибудь попадут в репозиторий.
# Сейчас образы Android скачиваются отдельно и в репозиторий не коммитятся.
*.img     filter=lfs diff=lfs merge=lfs -text
*.qcow2   filter=lfs diff=lfs merge=lfs -text
*.rdsnap  filter=lfs diff=lfs merge=lfs -text

Cargo.lock linguist-generated=false -diff
